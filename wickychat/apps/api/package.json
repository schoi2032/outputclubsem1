    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.9.1",
    "@fastify/swagger-ui": "^5.2.0",
    "@fastify/websocket": "^11.3.3",
    "@google-cloud/storage": "^8.2.0",
    "@node-rs/argon2": "^2.2.1",
    "@quid/db": "workspace:*",
    "@quid/shared": "workspace:*",
    "@vercel/blob": "^2.8.2",
