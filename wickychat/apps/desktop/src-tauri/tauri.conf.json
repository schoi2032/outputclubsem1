{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WickyChat",
  "version": "0.1.0",
  "identifier": "org.outputclub.wickychat",
  "build": {
    "frontendDist": "../offline"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "SocialNetworking",
    "shortDescription": "Chadwick International's school chat",
    "longDescription": "WickyChat, the school chat app made by Output Club at Chadwick International.",
    "copyright": "Output Club",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
